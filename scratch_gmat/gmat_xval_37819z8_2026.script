%General Mission Analysis Tool(GMAT) Script
%  OREM issue #32 Phase 5, batch cross-check (37819). Same methodology
%  as the 42928/39615 checks: independently propagate OREM's current
%  (2026-07-25) zone-8 (latest zone) fitted state through GMAT's own
%  JacchiaRoberts drag model, checking whether the ~45% gap found
%  twice already holds across a wider spread of perigee altitudes.
%  This object also has the highest inclination in the batch (63.2 deg).
%
%  Zone-8 IC (SGP4-osculating, epoch 2456429.327437 JD = 16 May 2013
%  19:51:30.557 UTC), from orem.F's own internal state via a temporary
%  debug dump (reverted, not shipped). Fitted (Z8, GA): ECC=0.223544,
%  BN=40.611, perigee-preserving SMA=8394.345455, TA=180.308777 (MA
%  resolved via Kepler's equation using e_opt, matching oe2car).
%  Perigee altitude at fit time: 139.70 km.
%  OREM predicted elapsed: 96.25 days (horizon 118.17d).
%  Force model identical to every prior cross-check in this batch:
%  EGM2008 zonal Degree=20/Order=0, Sun+Luna point mass, SRP on,
%  JacchiaRoberts CONSTANT F107=72/F107A=72/Kp=1.0. Stop threshold 102km.

Create ForceModel FMc;
GMAT FMc.CentralBody = Earth;
GMAT FMc.PrimaryBodies = {Earth};
GMAT FMc.PointMasses = {Sun, Luna};
GMAT FMc.GravityField.Earth.Degree = 20;
GMAT FMc.GravityField.Earth.Order = 0;
GMAT FMc.GravityField.Earth.PotentialFile = 'C:\Users\hari2\OneDrive\Documents\GitHub\KSROP\scratch_gmat\EGM2008_72x72.cof';
GMAT FMc.Drag.AtmosphereModel = JacchiaRoberts;
GMAT FMc.Drag.HistoricWeatherSource = 'ConstantFluxAndGeoMag';
GMAT FMc.Drag.PredictedWeatherSource = 'ConstantFluxAndGeoMag';
GMAT FMc.Drag.F107 = 72;
GMAT FMc.Drag.F107A = 72;
GMAT FMc.Drag.MagneticIndex = 1.0;
GMAT FMc.SRP = On;

Create Propagator Propc;
GMAT Propc.FM = FMc;
GMAT Propc.Type = RungeKutta89;
GMAT Propc.InitialStepSize = 10;
GMAT Propc.Accuracy = 1e-12;
GMAT Propc.MinStep = 0.001;
GMAT Propc.MaxStep = 300;

Create Spacecraft SCc;
GMAT SCc.DateFormat = UTCGregorian;
GMAT SCc.Epoch = '16 May 2013 19:51:30.557';
GMAT SCc.CoordinateSystem = EarthMJ2000Eq;
GMAT SCc.DisplayStateType = Keplerian;
GMAT SCc.SMA = 8394.345455;
GMAT SCc.ECC = 0.223544;
GMAT SCc.INC = 63.242802;
GMAT SCc.RAAN = 60.068210;
GMAT SCc.AOP = 218.095785;
GMAT SCc.TA = 180.308777;
GMAT SCc.Cd = 1;
GMAT SCc.DragArea = 1;
GMAT SCc.DryMass = 40.611;
GMAT SCc.Cr = 1.2;
GMAT SCc.SRPArea = 0.406110;

Create ReportFile Repxv;
GMAT Repxv.Filename = 'gmat_xval_37819z8_2026_results.txt';
GMAT Repxv.Precision = 16;
GMAT Repxv.WriteHeaders = true;

BeginMissionSequence;

Report Repxv SCc.UTCModJulian SCc.ElapsedDays SCc.Earth.Altitude;
Propagate Propc(SCc) {SCc.Earth.Altitude = 102, SCc.ElapsedDays = 1200};
Report Repxv SCc.UTCModJulian SCc.ElapsedDays SCc.Earth.Altitude;
