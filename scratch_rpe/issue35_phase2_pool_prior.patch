+c     ============================================================
+      subroutine estimate_bn_pool_prior(bn_pool, npool, maxpool,
+     &   bn_lo_in, bn_hi_in, bn_lo_out, bn_hi_out)
+c
+c     Issue #35 (Phase 2): non-recursive, robust BN search-range prior
+c     pooled from ALL prior trusted-and-not-boundary-pinned zones, not
+c     just the immediately preceding one -- replaces the recursive
+c     trust-gated narrow/widen-on-boundary carryover (removed after a
+c     direct A/B test found plain removal alone regressed the primary
+c     metric on both curated validation sets). Unlike that mechanism,
+c     results depend on WHICH zones are in the pool, not on the ORDER
+c     they were processed in, so one early zone's idiosyncrasy can no
+c     longer compound zone over zone into an increasingly overconfident
+c     window -- each call recomputes fresh from the caller's own fixed
+c     range plus whatever pool it's given.
+c
+c     0 pool points: search the full caller-supplied range unchanged.
+c     1 point: a bounded multiplicative window [0.5x, 2.0x] around it.
+c     >=2 points: median +/- 3*MAD (median absolute deviation, x1.4826
+c     for normal-consistent scaling), floored at 15% of the median so
+c     near-identical trusted zones don't collapse the window to
+c     near-zero width.
+c     Always intersected against the caller's own [bn_lo_in,bn_hi_in]
+c     (never widens beyond it), same floor-only spirit as G2/G3; falls
+c     back to the caller's unmodified range if the computed window is
+c     degenerate (non-positive width after intersection).
+c
+c     Input
+c       bn_pool(npool) : fitted BN of each prior trusted, non-boundary
+c                        zone (caller builds this -- see orem_run's own
+c                        trust-gate + bn_at_bound_hist loop)
+c       npool          : count (0 if none)
+c       maxpool        : declared dimension of bn_pool
+c       bn_lo_in, bn_hi_in : fixed range to intersect against
+c
+c     Output
+c       bn_lo_out, bn_hi_out : narrowed range
+c     ============================================================
+      implicit double precision (a-h, o-z)
+      integer npool, maxpool
+      double precision bn_pool(maxpool)
+      double precision bn_lo_in, bn_hi_in, bn_lo_out, bn_hi_out
+
+      double precision vals(500), vtmp, bn_med, bn_mad, bn_spread
+      integer i, j
+
+      if (npool .le. 0) then
+         bn_lo_out = bn_lo_in
+         bn_hi_out = bn_hi_in
+         return
+      end if
+
+      if (npool .eq. 1) then
+         bn_lo_out = max(bn_lo_in, 0.5d0*bn_pool(1))
+         bn_hi_out = min(bn_hi_in, 2.0d0*bn_pool(1))
+      else
+         do i = 1, npool
+            vals(i) = bn_pool(i)
+         end do
+         do i = 2, npool
+            vtmp = vals(i)
+            j = i - 1
+            do while (j .ge. 1 .and. vals(j) .gt. vtmp)
+               vals(j+1) = vals(j)
+               j = j - 1
+            end do
+            vals(j+1) = vtmp
+         end do
+         if (mod(npool,2) .eq. 1) then
+            bn_med = vals((npool+1)/2)
+         else
+            bn_med = 0.5d0*(vals(npool/2) + vals(npool/2+1))
+         end if
+
+         do i = 1, npool
+            vals(i) = dabs(vals(i) - bn_med)
+         end do
+         do i = 2, npool
+            vtmp = vals(i)
+            j = i - 1
+            do while (j .ge. 1 .and. vals(j) .gt. vtmp)
+               vals(j+1) = vals(j)
+               j = j - 1
+            end do
+            vals(j+1) = vtmp
+         end do
+         if (mod(npool,2) .eq. 1) then
+            bn_mad = vals((npool+1)/2)
+         else
+            bn_mad = 0.5d0*(vals(npool/2) + vals(npool/2+1))
+         end if
+         bn_mad = bn_mad * 1.4826d0
+         bn_spread = max(bn_mad, 0.15d0*bn_med)
+
+         bn_lo_out = max(bn_lo_in, bn_med - 3.d0*bn_spread)
+         bn_hi_out = min(bn_hi_in, bn_med + 3.d0*bn_spread)
+      end if
+
+c     Floor clamp BEFORE the degeneracy check -- a tight npool==1
+c     multiplicative window entirely below 10 (e.g. bn_pool(1)=1 ->
+c     [0.5,2.0]) would otherwise pass the check below with lo<hi, then
+c     get clamped to lo=10 > hi=2.0, a degenerate range the check
+c     never saw. Checking after flooring catches this case too.
+      if (bn_lo_out .lt. 10.d0) bn_lo_out = 10.d0
+      if (bn_lo_out .ge. bn_hi_out) then
+         bn_lo_out = bn_lo_in
+         bn_hi_out = bn_hi_in
+      end if
+
+      return
+      end
+
