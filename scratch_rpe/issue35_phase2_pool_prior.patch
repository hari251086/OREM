+c     ============================================================
+c     Issue #35 (Phase 2): estimate_bn_pool_prior unit tests --
+c     exact median/MAD/window arithmetic against hand-computed cases.
+c     ============================================================
+      subroutine test_bn_pool_prior(npass, nfail)
+      implicit double precision (a-h, o-z)
+      integer npass, nfail
+
+      parameter(mp = 4)
+      double precision bn_pool(mp)
+      double precision bn_lo_out, bn_hi_out
+
+c     P1: npool=0 -- range passes through unchanged
+      call estimate_bn_pool_prior(bn_pool, 0, mp,
+     &   80.d0, 160.d0, bn_lo_out, bn_hi_out)
+      call assert_d('P1 npool=0: lo unchanged',
+     &   bn_lo_out, 80.d0, 1.d-9, npass, nfail)
+      call assert_d('P1 npool=0: hi unchanged',
+     &   bn_hi_out, 160.d0, 1.d-9, npass, nfail)
+
+c     P2: npool=1, bn_pool(1)=100 -> [0.5x,2.0x]=[50,200],
+c     intersected with [10,300] -> [50,200]
+      bn_pool(1) = 100.d0
+      call estimate_bn_pool_prior(bn_pool, 1, mp,
+     &   10.d0, 300.d0, bn_lo_out, bn_hi_out)
+      call assert_d('P2 npool=1: lo=0.5x',
+     &   bn_lo_out, 50.d0, 1.d-6, npass, nfail)
+      call assert_d('P2 npool=1: hi=2.0x',
+     &   bn_hi_out, 200.d0, 1.d-6, npass, nfail)
+
+c     P3: npool=2, {80,120} -> median=100, MAD=20*1.4826=29.652,
+c     spread=max(29.652,15)=29.652 -> [100-88.956,100+88.956]
+      bn_pool(1) = 80.d0
+      bn_pool(2) = 120.d0
+      call estimate_bn_pool_prior(bn_pool, 2, mp,
+     &   10.d0, 300.d0, bn_lo_out, bn_hi_out)
+      call assert_d('P3 npool=2: median-3*MAD',
+     &   bn_lo_out, 11.044d0, 1.d-2, npass, nfail)
+      call assert_d('P3 npool=2: median+3*MAD',
+     &   bn_hi_out, 188.956d0, 1.d-2, npass, nfail)
+
+c     P4: npool=3, {90,100,110} -> median=100, MAD=10*1.4826=14.826,
+c     spread=max(14.826, 0.15*100=15)=15 (the 15% floor binds here,
+c     not the MAD itself) -> [100-45,100+45]=[55,145]
+      bn_pool(1) = 90.d0
+      bn_pool(2) = 100.d0
+      bn_pool(3) = 110.d0
+      call estimate_bn_pool_prior(bn_pool, 3, mp,
+     &   10.d0, 300.d0, bn_lo_out, bn_hi_out)
+      call assert_d('P4 npool=3: 15% spread floor binds (lo)',
+     &   bn_lo_out, 55.d0, 1.d-6, npass, nfail)
+      call assert_d('P4 npool=3: 15% spread floor binds (hi)',
+     &   bn_hi_out, 145.d0, 1.d-6, npass, nfail)
+
+c     P5: regression test for the floor-clamp/degeneracy ordering bug.
+c     npool=1, bn_pool(1)=4 -> window=[2,8]; intersected with
+c     [bn_lo_in=2, bn_hi_in=300] -> [2,8] (not degenerate yet). The
+c     absolute bn_lo<10 floor clamp must be applied BEFORE the
+c     degeneracy check, not after -- otherwise clamping lo to 10 here
+c     leaves [10,8], a silently-degenerate range no caller should ever
+c     receive. Correct behavior: the clamp creates the degeneracy,
+c     which the (correctly-ordered) check then catches and falls all
+c     the way back to the caller's own [bn_lo_in,bn_hi_in]=[2,300].
+      bn_pool(1) = 4.d0
+      call estimate_bn_pool_prior(bn_pool, 1, mp,
+     &   2.d0, 300.d0, bn_lo_out, bn_hi_out)
+      call assert_d('P5 floor-clamp degeneracy: falls back to lo_in',
+     &   bn_lo_out, 2.d0, 1.d-9, npass, nfail)
+      call assert_d('P5 floor-clamp degeneracy: falls back to hi_in',
+     &   bn_hi_out, 300.d0, 1.d-9, npass, nfail)
+
+      return
+      end
+
